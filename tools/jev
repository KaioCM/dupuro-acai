#!/usr/bin/env python3
"""jev — chama o Jev (TypeSafe) da linha de comando. Ferramenta de desenvolvimento,
não roda no site. Só biblioteca padrão; a chave vem de $TYPESAFE_API_KEY (nunca argumento).

  jev yes   "PERGUNTA" [--state TEXTO|@arquivo|-]
  jev pick  "PERGUNTA" chave="descrição" chave2="descrição" [--outro] [--state ...]
  jev score "PERGUNTA" "nível 0" "nível 1" ... [--state ...]
  jev trechos "PERGUNTA" arquivo [arquivo...] [--linhas 100] [--top 3] [--min 0.5]

Saída curta (feita pra quem lê ser o Claude): uma linha por resposta.
Códigos de saída: yes → 0 sim / 1 não; pick/score → 0 / 1 se confiança < --min-conf;
trechos → 0 achou trecho >= --min / 1 nenhum; 2 = erro.
Veja .claude/skills/dupuro-jev/SKILL.md para quando usar (e quando não).
"""
import argparse, json, os, sys, time, urllib.error, urllib.request
from concurrent.futures import ThreadPoolExecutor

URL = "https://api.typesafe.ai/v1/systemone"
MODEL = os.environ.get("JEV_MODEL", "jev-latest")
PRECO_MTOK = 0.042  # US$ por milhão de tokens de entrada (docs.typesafe.ai/models)


def chamar(state, questions):
    key = os.environ.get("TYPESAFE_API_KEY")
    if not key:
        sys.exit("jev: defina TYPESAFE_API_KEY no ambiente")
    body = json.dumps({"model": MODEL, "state": state, "questions": questions}).encode()
    for tentativa in range(5):
        req = urllib.request.Request(URL, data=body, headers={
            "Authorization": "Bearer " + key, "Content-Type": "application/json"})
        try:
            with urllib.request.urlopen(req, timeout=90) as r:
                return json.load(r)
        except urllib.error.HTTPError as e:
            if e.code in (429, 500, 502, 503, 504, 529) and tentativa < 4:
                time.sleep(2 ** (tentativa + 1))
                continue
            print(f"jev: HTTP {e.code} {e.read()[:300].decode(errors='replace')}", file=sys.stderr)
            sys.exit(2)
        except urllib.error.URLError as e:
            if tentativa < 4:
                time.sleep(2 ** (tentativa + 1))
                continue
            print(f"jev: rede: {e.reason}", file=sys.stderr)
            sys.exit(2)


def ler_state(v):
    if v is None:
        return ""
    if v == "-":
        return sys.stdin.read()
    if v.startswith("@"):
        return open(v[1:], encoding="utf-8").read()
    return v


def custo(tokens):
    return f"{tokens} tok, US$ {tokens * PRECO_MTOK / 1e6:.5f}"


def cmd_yes(a):
    r = chamar(ler_state(a.state), {"q": {"type": "noul", "instructions": a.pergunta}})
    p = r["answers"]["q"]["noul"]
    print(f"{'yes' if p >= 0.5 else 'no'}\t{p:.2f}\t({custo(r['usage']['input_tokens'])})")
    return 0 if p >= 0.5 else 1


def cmd_pick(a):
    crit = {}
    for o in a.opcoes:
        k, _, d = o.partition("=")
        crit[k.strip()] = d.strip() or k.strip()
    if a.outro:
        crit["outro"] = "None of the other options fits."
    r = chamar(ler_state(a.state), {"q": {"type": "choice", "instructions": a.pergunta, "criteria": crit}})
    ans = r["answers"]["q"]
    probs = " ".join(f"{k}={v:.2f}" for k, v in sorted(ans["probabilities"].items(), key=lambda kv: -kv[1]))
    print(f"{ans['choice']}\tconf {ans['confidence']:.2f}\t{probs}\t({custo(r['usage']['input_tokens'])})")
    return 0 if ans["confidence"] >= a.min_conf else 1


def cmd_score(a):
    r = chamar(ler_state(a.state), {"q": {"type": "score", "instructions": a.pergunta, "criteria": a.niveis}})
    ans = r["answers"]["q"]
    probs = " ".join(f"{k}={v:.2f}" for k, v in ans["probabilities"].items())
    print(f"{ans['score']:.2f}\tconf {ans['confidence']:.2f}\t{probs}\t({custo(r['usage']['input_tokens'])})")
    return 0 if ans["confidence"] >= a.min_conf else 1


def cmd_trechos(a):
    """Divide os arquivos em blocos de N linhas e pergunta ao Jev, bloco a bloco, se ali
    está o que a pergunta procura. Imprime os melhores como arquivo:início-fim."""
    blocos = []
    for arq in a.arquivos:
        linhas = open(arq, encoding="utf-8", errors="replace").read().splitlines()
        for i in range(0, len(linhas), a.linhas):
            blocos.append((arq, i + 1, min(i + a.linhas, len(linhas)), "\n".join(linhas[i:i + a.linhas])))
    q = {"q": {"type": "noul", "instructions": "Does this excerpt contain the code or text that answers the "
                                              "question below?\nQuestion: " + a.pergunta}}

    def um(b):
        r = chamar({"file": b[0], "first_line": b[1], "excerpt": b[3]}, q)
        return b, r["answers"]["q"]["noul"], r["usage"]["input_tokens"]

    with ThreadPoolExecutor(8) as ex:
        res = list(ex.map(um, blocos))
    res.sort(key=lambda x: -x[1])
    tok = sum(x[2] for x in res)
    bons = [x for x in res if x[1] >= a.min][:a.top] or res[:1]
    for b, p, _ in bons:
        print(f"{b[0]}:{b[1]}-{b[2]}\t{p:.2f}")
    print(f"({len(blocos)} blocos, {custo(tok)})", file=sys.stderr)
    return 0 if res and res[0][1] >= a.min else 1


def main():
    ap = argparse.ArgumentParser(prog="jev", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("yes"); s.add_argument("pergunta"); s.add_argument("--state")
    s = sub.add_parser("pick"); s.add_argument("pergunta"); s.add_argument("opcoes", nargs="+")
    s.add_argument("--state"); s.add_argument("--outro", action="store_true"); s.add_argument("--min-conf", type=float, default=0.0)
    s = sub.add_parser("score"); s.add_argument("pergunta"); s.add_argument("niveis", nargs="+")
    s.add_argument("--state"); s.add_argument("--min-conf", type=float, default=0.0)
    s = sub.add_parser("trechos"); s.add_argument("pergunta"); s.add_argument("arquivos", nargs="+")
    s.add_argument("--linhas", type=int, default=100); s.add_argument("--top", type=int, default=3)
    s.add_argument("--min", type=float, default=0.5)
    a = ap.parse_args()
    sys.exit({"yes": cmd_yes, "pick": cmd_pick, "score": cmd_score, "trechos": cmd_trechos}[a.cmd](a))


if __name__ == "__main__":
    main()
